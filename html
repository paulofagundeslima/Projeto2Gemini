:root {
  --bg-color: #F8FAFC;
  --card-bg: #FFFFFF;
  --text-main: #0F172A;
  --primary: #1E40AF;
  --primary-hover: #1D4ED8;
  --danger: #B91C1C;
  --danger-hover: #991B1B;
  --border-color: #CBD5E1;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 22px;
  line-height: 1.6;
  background-color: var(--bg-color);
  color: var(--text-main);
  padding: 16px;
  max-width: 600px;
  margin: 0 auto;
}

header {
  text-align: center;
  padding: 24px 16px;
  background-color: var(--primary);
  color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 20px;
}

header h1 {
  font-size: 32px;
  margin-bottom: 4px;
}

.btn-emergency {
  display: block;
  width: 100%;
  padding: 20px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  color: #FFFFFF;
  background-color: var(--danger);
  border: none;
  border-radius: 12px;
  text-decoration: none;
  margin-bottom: 24px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.btn-emergency:focus, .btn-emergency:hover {
  background-color: var(--danger-hover);
  outline: 4px solid #FCA5A5;
}

.tab-list {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.tab-button {
  flex: 1;
  padding: 16px;
  background-color: #E2E8F0;
  color: var(--text-main);
  font-size: 20px;
  font-weight: bold;
  border-radius: 8px;
  cursor: pointer;
  border: 3px solid var(--border-color);
}

.tab-button[aria-selected="true"] {
  background-color: var(--primary);
  color: #FFFFFF;
  border-color: var(--primary);
}

.tab-button:focus {
  outline: 4px solid #93C5FD;
}

.tab-content, .card-section {
  background-color: var(--card-bg);
  border: 3px solid var(--border-color);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.tab-content[hidden] {
  display: none;
}

.alert-box {
  background-color: #FEF2F2;
  border-left: 8px solid var(--danger);
  padding: 16px;
  margin-top: 16px;
  border-radius: 4px;
}

.tip-box {
  background-color: #EFF6FF;
  border-left: 8px solid var(--primary);
  padding: 16px;
  margin-top: 16px;
  border-radius: 4px;
}

h2 {
  font-size: 26px;
  margin-bottom: 12px;
  color: var(--primary);
}